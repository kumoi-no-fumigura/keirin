 "poems": [
  {
   "seq": "1",
   "text": "いつしかと山は雪けにたつ雲の消るかたより霞む空かな",
   "kana": "",
   "speaker": "源直朝",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "つもりこし尾上の雪のむら消は所〓に春や來ぬらん",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "橫雲の別るゝきはの山のはのおほつかなきや霞なるらむ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "今朝は猶霞にけりなあしひきの山のは〓との遠さかるまで",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "みやまへや木末の雪はそれなから先打とくる鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "梅のはな咲にけらしな鶯の谷のふる巢をいつる初こゑ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ふる里の難波わたりの梅かゝにいまもむかしの春かせそ吹",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春くれは宿とふ人のふゑの音に吹あはすめる梅の下かせ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "このねぬる袖のまくらの朝露にのこる月さへ梅かゝそする",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "道のへの花は一木の梅なからおほくの人の袖そ匂へる",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "梅のはなかさしにさせはをのつから袖に消せぬ雪そふりける",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "打むれてわかな摘なり春日野の雪はみとりに成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "うちかすむ柳の糸や佐保姫の朝氣のまゆのみたれ成らん",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "山賤の門田の柳春はまつ水のみとりの種やまくらん",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "大空は霞なからに春雨のふるえの柳いろそそひゆく",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "春雨はその色としもみえさりし霞の下の露の若くさ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いかなれは越路の月をよそにみてかへるか鴈は花のさかりを",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "はるの夜は木の間かくれをもる影の霞てふくる有明の月",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "春はなを暮かたをそし山櫻入日のかけの花にのこりて",
   "kana": "",
   "speaker": "桂林集春",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "むかしなと雲にまかへて詠けん花より外の花はあらしを",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "久かたの月は霞のはるのよに花の光そさやか成ける",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "峯の月なかめあかしてけさみれは木末の花になりにける哉",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "山櫻先みにゆかんあらましの友さそふまに散も社すれ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "とふ人の有ともいまは我宿の花散庭に跡やいとはむ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ちるまゝに山の櫻のあるはなくなきは數そふ花の陰かな",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "色も香も花はむかしのまゝなから我身ひとつの春の夕暮",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "吹送るかせのたよりの遠けれは花は句はすみねのしらくも",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "霞む夜の月はかりさへある物をさそな太山の花の明ほの",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "山さくら盛になれは折〓〓のくもや雲間の花とみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "みよしのゝ吉野の河に淀はあれと花の波には山陰もなし",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "行やらてけふも暮しつ山櫻君かためとや雪とふるらん",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "雨ふれは山田のつゝみ水越て草の葉末に蛙なくなり",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "いかなれは淺澤ぬまのかきつはたこきむらさきに花の咲らん",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "日にそへて波やかくらんむらさきの藤江の松の枝もたはゝに",
   "kana": "",
   "speaker": "",
   "page": 496,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "陰たかき松の梢に咲藤の花の聲きく春の夕くれ",
   "kana": "",
   "speaker": "桂林集夏",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "老か世の末をおもへは年〓〓にまさりておしき春の暮かな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "山のはのそれともみえすけふの日の暮るや春のかへる成らん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "けふはゝや四方の山邊の春かすみ衣〓〓にしも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "暮はつる空そ悲しき老らくのこんといふなる春もしられす",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "なれ〓〓し春を殘して夏衣かへても袖は花の香そする",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "うのはなの咲る垣ねはよな〓〓に雲かくれせぬ月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "ふるさとは庭の蓬をそのまゝにあやめに添てふく軒はかな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "待しよりねぬ夜の空の一聲を夢とはきかし山ほとゝきす",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "郭公なかぬよころにならひ來てそれともわかぬ今の一こゑ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "ほとゝきす月の桂にやとるらし空さりけなく聲の落くる",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "ほとゝきす夢かとたとる一聲に猶まとろまん心地こそせね",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "むさし野は木陰も見えすほとゝきすいくかを草の原に鳴らん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "故〓の草はみなからひともとのはなたち花の香にゝほふらむ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "むかしにもあらめね覺をなくさめてまくら匂はす軒の立はな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "昔思ふさよの寢覺の袖の上に我も有とやのきのたち花",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "五月雨はそれならぬかたも八橋や水ゆく河の瀨〓のしらなみ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "けふいくかふるえの柳打なひきなみに波よる五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "風にあれで月もかほとはふかさりし閨の板まの五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "田子のとるさなへのつゆの玉たすきかけて心に秋やまつらん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "露をたにやとしかれたる若草の結ふはかりにしける頃かな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "夏のゝはかやか綠もひとつにて花なるくさや秋を待らん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "一本のそれともわかす武藏野の草はみなからしける頃かな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "峯ちかき小川の舟のみなれさほさすほともなき月の影かな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "夏かりの玉えの芦のもとをあらみいさよふ影やみしか夜の月",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "手にならす扇の風もわすれつゝ月にまかする夏の夜のそら",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "大井川岸にいさよふかゝり火はゐせきにかゝる鵜舟なるらん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "むら〓〓のまこもつゝきの沼水にみえかくれつゝ飛螢かな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "ほたる飛汀の芦のよな〓〓にをかぬ露ちるかけのすゝしさ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "紅ににほへは花もにこるとや玉もてみかく蓮葉の露",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "池のおものはすのうき葉の茂りあひて水も濁れる影のなき哉",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "遠かたの空のむら雲それかともいひあへぬまにかゝる夕たち",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "すゝしさの今誰かたに成ぬらん遠さかりゆくゆふたちの空",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "夕されは池の玉藻にあそふ魚のしつむはかりにかけも涼しき",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "我門の竹の葉そよく風の音にみな〓宿の夏そかくるゝ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "水上にみそきやすらん麻の葉のしからみかくる瀨〓の白波",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "御秡河なかるゝ水に夏はゆきあきはこえくるせゝの夕波",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "今朝ははやいかなる人の心にも秋のいろをし思ひわくらん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いつもきく高根の松の聲なれとけさしもいかて身にはしむ覽",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "天河なかるゝ水にことよせて歸らぬ中のちきりともかな",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "天川曉の空にたつ雲の消かへるをや心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "下ふしもたえて物おもふ夕ともしらてや軒の荻の上かせ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "荻の葉にかけ打そよく夕暮は波こゝもとの秋の古〓",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "起わかれねすりの衣うらふれてしほるかのへの萩の下露",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "尾上をは月にこえ來て明かたの麓の霧にまよふ鴈金",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "小男鹿の妻戀すらしむは玉の夜寒かさなる山の秋風",
   "kana": "",
   "speaker": "桂林集秋",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "露霜は消かへりてもありぬへし哀いのちを松虫の啼",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "出ていにし人はかきせぬよもきふの宿にはかなき松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "さやかなる月には猶もくもるらん心ある人の秋の夜すから",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "今まてはたのめすとても秋はへぬ老のたもとにやとる月影",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "詠つゝ哀もまさりうきことも思ひなくさむあきの夜の月",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "かき曇月も詠るかひそなきこよひ明石のとまりなれとも",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "今夜しも我身はもとの秋ならてみるをや月もさそ思ふらん",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "千〓の秋みかともあかし君か代はそらゆく月の影たえぬまて",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "春の山も忘れにけりな秋の野の月と花とのゆふくれの空",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "難波かたしほみちくれは汀なるあしの末葉にかゝる月かけ",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "そらはれてあくる麓の霧のうみにうかひ出たるおきつ島山",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "秋ふかみ霧たちこめて山河の岩こすなみも下むせふなり",
   "kana": "",
   "speaker": "",
   "page": 497,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "山ふかみ露しく袖もわかぬ夜のねさめならはす松風の聲",
   "kana": "",
   "speaker": "桂林集冬",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ゆふされは尾花か波もくたけつゝつゆを分ゆくまのゝ浦かせ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "露ふかきのきのむくらのかせはれて庭もまかきも野への秋風",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "落瀧津河せのなみの行かたに霧の聲きく秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "時雨ゆく雲の衣ををりかけてから紅にそむる山のは",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "淵も瀨ももみちになりぬ立田河くれなゐくゝる水や絕なん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "夕しくれ過ぬるあとの木〓の色をまた一入の山のはの月",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "しらきくの花もてゆへる庭の面のまかきそ秋のさかり成ける",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "しら露の衣手句ふきくの花たそかれときの霧の籬に",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "君の代にあふへき秋はおほけれとまつ社おらめ菊の一えた",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "わすれてはたゝおしまるゝ心かな我やはよ所の秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "かけさむき尾花かすゑの波の間に添もあへぬ秋の日の影",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "けふもはや暮はてにけり今朝の露のこるもはかな秋の形見に",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "山河や日數うつろふ紅葉はのなかれもあへす冬は來にけり",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "住あらす草の庵の小夜時雨おもへは月ももらぬかけかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "柴の戶に木の葉吹おろす山かけもなるれは餘所の夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "冬ふかくなりにけらしな山里の木のはは閨の月もらぬまて",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "尾上より風にちりゆく紅葉はゝ空もくもらて降時雨かな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "秋の山染し時雨はふりはてゝ嵐色つくゆふ暮の空",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "淺ちふの小のゝ冬草すゑ葉にも餘りてみゆる霜の寒けさ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "をく霜はあらしやはろふ冬草の枯なてのこる野への松陰",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "難波江や霜をかされてしほれ蘆のほのかにかせの殘る頃かな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "枯わたる芦の葉したり降雪のほなみにかへす秋の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "さゆる夜は芦のほかけを衾にて下にかたしくをしの毛衣",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "みたれふす芦のしほれ葉ふみしたき霜打拂ひ鴛のなく聲",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "くれかゝる浦のとまやに宿かれは我友ちとりなみになくなり",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "月さえてあかしの浦の友ちとりほの〓〓みゆる島つたふらん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "山かはのさむく日〓に眞菅おふる岩ねの水そかつ氷ゆく",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "影やとす波は氷て志賀の浦や松はいまこそ一木成けれ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "池の面にうつろふ月のみかゝれてあまつ空まて氷る夜半かな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "宿はあれぬ淺茅葎の霜のうへになを影寒し冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "をとつれも絕て程ふろ我やとにさりとて人はけさのはつ雪",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "問ぬとて人なうらみそ我も又跡たにおしき今朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "軒ちかきまかきの竹の雪折にふしのまもなく明す夜半哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "大原や小野の炭かま風吹はやかぬ峯にもたつ煙かな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "うきときは身にたくへつゝ埋火の消なて殘る世にも有かな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "月日たゝなかれもあへす暮ばてゝ我年なみにしからみそなき",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "ことに出はかくと思ひし言の葉も打むかひては忘れはてけり",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "かれれたゝ軒の信夫のもみちして色に出ぬと名のたゝぬまに",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "しらしかし木の葉散埋む谷川の水のなかれて下むせふとは",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "はかなくも後とないひそ我袖の色をし人のあやしめぬまに",
   "kana": "",
   "speaker": "桂林集戀",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "ちきりをく秋より先の露の命いかまほしくも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "人まてはあらしいまはの心かな山のは遠き月をなかめて",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "うつゝとも夢ともさらにわきも子かきてぬる夜半の袖の枕は",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "さめぬ間に消はてねたゝ烏羽玉のはかなき夢も又は現も",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "我かたのよるへしらせようきみるの浪にたゝよふ袖のうら風",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "かならすといひしなからも更行にたのめぬ月の夕暮のかけ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "たち出てゝ見をくるそらに有明の月も消ゆく人のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "ともに見しそのおもかけは殘りけり忘れかたみの今朝の月影",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "しるやいかに幾夜あけゆく篠目のしのにをりはへ物思ふとは",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "はてもなき心の空のうき雲をよその夕に何なかめけん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "おもひやるあたりの空の果もなく夕はかゝるうきも添らん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "こふるまも思ひそめける月日さへわするゝ程に成にける哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "よしやたゝうき名いとはし空のくもはては消なん跡の夕暮",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "ともに見し人の心はさもあらてむかしの秋にかへる月かけ",
   "kana": "",
   "speaker": "桂林集雜",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "またれつゝつれなしとても山のはに人たのめなる有明の月",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "いまよりや露も身にしむ若草のつまにこもれる末の秋風",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "うち出ぬ心はあさしはし鷹の身よりあまれる思ひみせなん",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "有明の月の光もあし曳の山のはちかき橫雲のそら",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "よな〓〓の枕の下に聞なれてよそにそおもふ軒のむらさめ",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "我心いく重の峯を越ぬらんなかむる山のゆふくれのそら",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "すみた河むかしいかにと〓とはゝわたらぬ浪にぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "立ならふ池のみきはのまつ陰は風と浪とのやとり成けり",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "もしほやく海士の衣のうら里のうら悲しくも立けふりかな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "あはれにもゆく年波はしら河のせきとめかたき旅の空かな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "雪消の水のしら浪岩越て音羽の瀧の名こそ高けれ",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "行暮てこよひ篠屋のふしの間をかりねくるしき風わたるなり",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "春は花秋はもみちのあたなれはうき世はなれてすむ山そなき",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "柴の戶にまた住なれぬやまの井やくみたにしらぬ心くらへん",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "朝夕は海士の仕業を見るからにうきてふ世をそ思ひしりぬる",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "淋しさも世にふるほとそ思ひにきたかなるはしの宿の松かせ",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "芦ねはふ入江につくる鳩の巢のうきなから社世にはすみけれ",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "よしやよはけふのうき瀨も飛鳥河わたりしられぬ末の白波",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "增鏡みれはかしらに霜そをくなか〓〓年のふるにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "山のはに出入かけと人はみつ月はひとつにすめるこゝろを",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "名にしおふ法の心をつたへ聞てやすく住へき花のうてなか",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "うたかたの哀とみすやむは玉の夢幻の人のよの中",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "今そしる五のとかは其儘にねかふ十聲のたのみある身は",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "我からとけたはやけたん心より燃るほのほも閉るも氷も",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "此世には契ありても天かけり地にふすたくひ何うまれけん",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "いつまてかあらき浪ちに迷ふへきはてなき海の底のすみかは",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "生れみる人の心のやみなれはさむるともなき夢のよの中",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "いかゝ思ふ〓との羽衣きては又なつるいはほのはてしなき世を",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "詠わひぬもろき木の葉の夕風に常なき世とは獨しりても",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "渡りえてうへなき空にすむ月のあたりはちかき雲のかけはし",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "枯はてゝいく春かふるはゝそ原忘ぬいろはねにそ殘れる",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "ありし世の心ならひに宿とへはおもはぬかたの苔の細道",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "つくは山しけき言葉の花の露苔の下にも光みゆらむ",
   "kana": "",
   "speaker": "桂林集雜",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "梓弓春の都をへたて來て東のかたにゐる空やなき",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "聞えあけて名をもたのむの鴈の聲身はしもなから雲の上迄",
   "kana": "",
   "speaker": "宣旨下し給はりぬる秋よろこびにた",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "かけ高き蓬か島の山〓〓は君か齡をつむにそありける",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "植をきし松も木高くなる儘におとろかれぬる我よはひかな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "君か代は〓とはりなれや石〓水神もにこらぬめくみのみして",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
